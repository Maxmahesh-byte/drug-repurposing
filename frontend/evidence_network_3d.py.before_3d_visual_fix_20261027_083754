def _safe_json(value: object) -> str:
    """Serialize JSON so untrusted text cannot terminate the embedding script."""
    return (
        json.dumps(value, ensure_ascii=False, separators=(",", ":"))
        .replace("<", "\\u003c")
        .replace(">", "\\u003e")
        .replace("&", "\\u0026")
    )


def render_evidence_network_3d(
    nodes: list[dict],
    links: list[dict],
    *,
    height: int = 760,
) -> None:
