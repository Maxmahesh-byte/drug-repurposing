    <div class="panel-kicker">Evidence detail</div>
    <div id="detail-title" class="panel-title">Selected tumour</div>
    <span id="detail-type" class="panel-type">Selected tumour label</span>
    <div class="panel-counts">
      <div class="count-tile"><b id="detail-samples">—</b><span>Labelled samples</span></div>
      <div class="count-tile"><b id="detail-genes">—</b><span>Indexed symbols</span></div>
      <div class="count-tile"><b id="detail-observations">—</b><span>Gene observations</span></div>
      <div class="count-tile"><b id="detail-visible">—</b><span>Visible gene nodes</span></div>
    </div>
