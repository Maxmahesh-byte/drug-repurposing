from __future__ import annotations

import json
from typing import Any

import streamlit as st
import streamlit.components.v1 as components


def _safe_json(value: object) -> str:
    """Serialize data safely for an inline HTML document."""
    return (
        json.dumps(value, ensure_ascii=False, separators=(",", ":"))
        .replace("<", "\\u003c")
        .replace(">", "\\u003e")
        .replace("&", "\\u0026")
    )


def render_evidence_network_3d(
    nodes: list[dict[str, Any]],
    links: list[dict[str, Any]],
    *,
    title: str,
    tumour_label: str,
    stats: dict[str, str],
    height: int = 850,
) -> None:
    """Render a labelled 3D evidence-provenance graph with a readable fallback.

    The graph only visualizes source lineage, selected tumour-label grouping,
    and descriptive aggregated gene-symbol observations. It does not encode
    biological causality, dependency, therapeutic response, or efficacy.
    """
    payload = _safe_json({
        "nodes": nodes,
        "links": links,
        "title": title,
        "tumourLabel": tumour_label,
        "stats": stats,
    })

    document = r'''<!doctype html>
