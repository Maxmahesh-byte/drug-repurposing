<script>
const DATA = __GRAPH_DATA__;
const EDGE = {clinical:'#79afe1', grouping:'#f1bf73', provenance:'#58c6b5', observation:'#b49aef'};
const esc = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt = value => Number(value || 0).toLocaleString('en-US');
const setText = (id, value) => { const el=document.getElementById(id); if(el) el.textContent=String(value ?? ''); };
setText('tumour-name', DATA.tumourLabel);
setText('detail-title', DATA.tumourLabel);
setText('detail-type', 'Tumour label');
setText('stat-samples', DATA.stats.samples);
setText('stat-genes', DATA.stats.genes);
setText('stat-observations', DATA.stats.observations);
setText('detail-samples', DATA.stats.samples);
setText('detail-genes', DATA.stats.genes);
setText('detail-observations', DATA.stats.observations);
setText('detail-visible', DATA.stats.visible);
setText('detail-text', `This view starts from the OpenPedCan tumour_type label “${DATA.tumourLabel}”. It links the matching clinical label-coverage count to the gene-associated summary grouped under the same exact text label. Individual gene nodes show aggregated observation counts. The graph is a provenance and navigation view, not a biological mechanism model.`);
const nodeById = new Map(DATA.nodes.map(n => [n.id,n]));
const linkIds = l => [typeof l.source==='object'?l.source.id:l.source, typeof l.target==='object'?l.target.id:l.target];

function renderFallback(reason) {
  const host=document.getElementById('fallback');
  const width=1100, height=520;
  const coords=new Map();
  DATA.nodes.forEach(n => coords.set(n.id,{x:width/2 + (Number(n.x)||0)*0.58, y:height/2 - (Number(n.y)||0)*0.58}));
  const lineMarkup=DATA.links.map(l=>{
    const [a,b]=linkIds(l), A=coords.get(a), B=coords.get(b);
    if(!A||!B)return '';
    return `<line x1="${A.x}" y1="${A.y}" x2="${B.x}" y2="${B.y}" stroke="${EDGE[l.kind]||'#8da7b7'}" stroke-width="2.2" opacity=".72"/>`;
  }).join('');
  const nodesMarkup=DATA.nodes.map(n=>{
    const p=coords.get(n.id), r=n.id==='disease:selected'?18:(n.kind==='Gene symbol'?8:12);
    const lines=String(n.displayLabel||n.label).split('\n');
    return `<g><circle cx="${p.x}" cy="${p.y}" r="${r+7}" fill="${n.color}" opacity=".12"/><circle cx="${p.x}" cy="${p.y}" r="${r}" fill="${n.color}" stroke="#e9f5f7" stroke-opacity=".7" stroke-width="1.3"/><text x="${p.x}" y="${p.y+r+18}" text-anchor="middle" fill="#eaf3f6" font-size="${n.kind==='Gene symbol'?12:14}" font-weight="700">${esc(lines[0])}</text><text x="${p.x}" y="${p.y+r+32}" text-anchor="middle" fill="#9eb6c4" font-size="10">${esc(lines[1]||n.kind)}</text></g>`;
  }).join('');
  host.innerHTML=`<svg viewBox="0 0 ${width} ${height}" role="img" aria-label="Fallback evidence relationship network"><defs><radialGradient id="fbGlow"><stop stop-color="#214a5b"/><stop offset="1" stop-color="#0a1e2e"/></radialGradient></defs><rect width="100%" height="100%" rx="18" fill="url(#fbGlow)"/>${lineMarkup}${nodesMarkup}</svg>`;
  host.style.display='block';
  document.getElementById('graph').style.display='none';
  document.getElementById('loaderror').style.display='none';
  setText('status', reason || 'Showing readable 2D fallback because the 3D renderer is unavailable.');
}

if (!window.ForceGraph3D || !window.SpriteText) {
  renderFallback('3D libraries unavailable · readable evidence map is shown instead.');
} else {
  const graphEl=document.getElementById('graph');
  let selectedId='disease:selected';
  let neighbourIds=new Set();
  let labelsOn=true;
  let autoOrbit=false;
  const nodes=DATA.nodes.map(n=>({...n}));
  const links=DATA.links.map(l=>({...l,source:l.source,target:l.target}));
  const baseLinkMap=DATA.links.map(l=>({...l}));

  const Graph = ForceGraph3D(graphEl,{controlType:'orbit',rendererConfig:{antialias:true,alpha:true}})
    .graphData({nodes,links})
    .backgroundColor('#0a1e2e')
    .showNavInfo(false)
    .nodeId('id')
    .nodeLabel(n=>`<div style="font-family:Inter,Arial;padding:8px 10px;max-width:260px"><b>${esc(n.label)}</b><br><span style="color:#a5c0cf">${esc(n.kind)}</span><br><span style="color:#d0dfe6">${esc(n.detail)}</span></div>`)
    .nodeColor(n=> n.id===selectedId ? '#fff0ce' : (selectedId && neighbourIds.size && !neighbourIds.has(n.id) && n.id!==selectedId ? '#233b4c' : n.color))
    .nodeVal(n=>n.value||5)
    .nodeRelSize(5.4)
    .nodeResolution(20)
    .nodeOpacity(.98)
    .nodeThreeObject(n=>{
      if(!labelsOn) return null;
      const txt = new window.SpriteText(n.displayLabel || n.label);
      txt.color = n.labelColor || n.color;
      txt.textHeight = n.labelHeight || (n.kind==='Tumour label'?15:(n.kind==='Gene symbol'?7:9));
      txt.fontFace = 'Inter, Arial, sans-serif';
      txt.fontWeight = n.kind==='Tumour label' ? 'bold' : '700';
      txt.backgroundColor = 'rgba(6,18,29,0.86)';
      txt.padding = n.kind==='Tumour label' ? 4 : 2;
      txt.borderRadius = 3;
      txt.borderWidth = 0.7;
      txt.borderColor = n.color;
      txt.strokeWidth = 0.35;
      txt.strokeColor = '#061522';
      txt.material.depthWrite = false;
      txt.position.y = n.labelOffsetY || (n.kind==='Gene symbol'?8:13);
      return txt;
    })
    .nodeThreeObjectExtend(true)
    .linkColor(l=>{
      const [a,b]=linkIds(l);
      if(!selectedId || !neighbourIds.size) return EDGE[l.kind] || '#8aa2b2';
      return (a===selectedId || b===selectedId || neighbourIds.has(a) || neighbourIds.has(b))
        ? (EDGE[l.kind] || '#8aa2b2') : '#203746';
    })
    .linkWidth(l=>l.kind==='grouping'?2.6:(l.kind==='observation'?1.7:1.9))
    .linkOpacity(.82)
    .linkDirectionalArrowLength(l=>l.kind==='observation'?3:5)
    .linkDirectionalArrowRelPos(1)
    .linkDirectionalArrowColor(l=>EDGE[l.kind] || '#8aa2b2')
    .linkDirectionalParticles(l=>l.kind==='observation'?2:1)
    .linkDirectionalParticleWidth(2.1)
    .linkDirectionalParticleSpeed(.003)
    .linkDirectionalParticleColor(l=>EDGE[l.kind]||'#c7d5dc')
    .linkLabel(l=>`<div style="font-family:Inter,Arial;padding:7px 9px"><b>${esc(l.label||'Evidence relationship')}</b><br><span style="color:#bacbd4">${esc(l.detail||'')}</span></div>`)
    .onNodeClick(node=>{
      selectedId=node.id;
      neighbourIds=new Set();
      baseLinkMap.forEach(l=>{const [a,b]=linkIds(l);if(a===node.id)neighbourIds.add(b);if(b===node.id)neighbourIds.add(a);});
      setText('detail-title',node.label);
      setText('detail-type',node.kind);
      setText('detail-text',node.detail||'No additional detail supplied.');
      setText('detail-source',`Source lineage\n${node.source||'Not specified'}`);
      Graph.nodeColor(Graph.nodeColor());
      Graph.linkColor(Graph.linkColor());
      const target={x:node.x||0,y:node.y||0,z:node.z||0};
      const len=Math.hypot(target.x,target.y,target.z)||1;
      const distance=270;
      const ratio=1+distance/len;
      Graph.cameraPosition({x:target.x*ratio,y:target.y*ratio,z:target.z*ratio},target,850);
    })
    .onLinkClick(link=>{
      const a=typeof link.source==='object'?link.source.label:link.source;
      const b=typeof link.target==='object'?link.target.label:link.target;
      setText('detail-title',link.label||'Evidence relationship');
      setText('detail-type',`Relationship · ${link.kind}`);
      setText('detail-text',`${a} → ${b}\n\n${link.detail||''}`);
      setText('detail-source','Relationship semantics are descriptive and source-defined.');
    });

  // Preserve the hand-laid evidence layers: the force engine should not scatter
  // the selected disease label away from its clinical and molecular context.
  Graph.d3Force('charge').strength(-12);
  Graph.d3Force('link').distance(l=>l.kind==='observation'?110:145).strength(.55);
  Graph.d3VelocityDecay(.48);
  Graph.warmupTicks(0);
  Graph.cooldownTime(2500);
  Graph.cameraPosition({x:30,y:45,z:1020},{x:40,y:0,z:0},0);
  Graph.controls().autoRotate=false;
  Graph.controls().autoRotateSpeed=.18;

  document.getElementById('orbit').addEventListener('click',ev=>{
    autoOrbit=!autoOrbit; Graph.controls().autoRotate=autoOrbit;
    ev.currentTarget.classList.toggle('active',autoOrbit);
    ev.currentTarget.textContent=`Auto orbit: ${autoOrbit?'on':'off'}`;
  });
  document.getElementById('labels').addEventListener('click',ev=>{
    labelsOn=!labelsOn;
    Graph.nodeThreeObject(n=>{
      if(!labelsOn)return null;
      const txt=new window.SpriteText(n.displayLabel||n.label);
      txt.color=n.labelColor||n.color; txt.textHeight=n.labelHeight||(n.kind==='Tumour label'?15:(n.kind==='Gene symbol'?7:9));
      txt.fontFace='Inter, Arial, sans-serif'; txt.fontWeight='700';
      txt.backgroundColor='rgba(6,18,29,0.86)';txt.padding=n.kind==='Tumour label'?4:2;txt.borderRadius=3;
      txt.borderWidth=.7;txt.borderColor=n.color;txt.material.depthWrite=false;
      txt.position.y=n.labelOffsetY||(n.kind==='Gene symbol'?8:13);return txt;
    });
    ev.currentTarget.classList.toggle('active',labelsOn);
    ev.currentTarget.textContent=`Labels: ${labelsOn?'on':'off'}`;
  });
  document.getElementById('fit').addEventListener('click',()=>Graph.zoomToFit(800,95));
  document.getElementById('reset').addEventListener('click',()=>{
    selectedId='disease:selected';neighbourIds=new Set();
    const tumour=nodeById.get('disease:selected');
    setText('detail-title',tumour.label);setText('detail-type',tumour.kind);
    setText('detail-text',tumour.detail);setText('detail-source',`Source lineage\n${tumour.source}`);
    Graph.nodeColor(Graph.nodeColor());
